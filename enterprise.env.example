# Enterprise LLM Configuration Example
# Copy the relevant sections to your .env.local file

# =============================================================================
# ENTERPRISE LLM CONFIGURATION
# =============================================================================

# REQUIRED: Your enterprise LLM endpoint
ENTERPRISE_LLM_URL=https://ai-gateway.yourcompany.com/api/v1/chat

# REQUIRED: Model name used by your enterprise system
ENTERPRISE_LLM_MODEL=llama-3-70b-enterprise

# OPTIONAL: API key (if your system uses API key auth instead of bearer tokens)
# ENTERPRISE_LLM_API_KEY=your_enterprise_api_key

# REQUIRED: Choose ONE of the authentication methods below

# =============================================================================
# AUTHENTICATION METHOD 1: Static Bearer Token
# =============================================================================
# Use this if you have a long-lived bearer token
ENTERPRISE_LLM_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_actual_token_here
ENTERPRISE_LLM_TOKEN_EXPIRY_HOURS=24

# =============================================================================
# AUTHENTICATION METHOD 2: OAuth Refresh Token Flow
# =============================================================================
# Use this if you have refresh token capabilities
# ENTERPRISE_LLM_REFRESH_URL=https://auth.yourcompany.com/oauth/token
# ENTERPRISE_LLM_CLIENT_ID=your_oauth_client_id
# ENTERPRISE_LLM_CLIENT_SECRET=your_oauth_client_secret
# ENTERPRISE_LLM_REFRESH_TOKEN=your_refresh_token_here

# =============================================================================
# AUTHENTICATION METHOD 3: Client Credentials Flow
# =============================================================================
# Use this for service-to-service authentication
# ENTERPRISE_LLM_REFRESH_URL=https://auth.yourcompany.com/oauth/token
# ENTERPRISE_LLM_CLIENT_ID=service-account-ai-chatbot
# ENTERPRISE_LLM_CLIENT_SECRET=your_service_account_secret

# =============================================================================
# OPTIONAL: Custom Configuration
# =============================================================================

# Custom headers required by your enterprise API (JSON format)
ENTERPRISE_LLM_HEADERS={"X-API-Version": "v2", "X-Client-Name": "hackathon-chatbot", "X-Department": "Engineering"}

# Model parameters
ENTERPRISE_LLM_TEMPERATURE=0.1
ENTERPRISE_LLM_MAX_TOKENS=4000
ENTERPRISE_LLM_TIMEOUT=600000

# =============================================================================
# TESTING COMMANDS
# =============================================================================

# After configuring, test with:
# curl http://localhost:3000/api/llm/providers
# curl -X POST http://localhost:3000/api/llm/providers -d '{"provider": "enterprise"}'
# curl -X POST http://localhost:3000/api/chat -d '{"message": "Test enterprise LLM"}'
